# Firebase Configuration (Get from Firebase Console > Project Settings)
# These are public keys, safe to expose in the browser
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/croplink?retryWrites=true&w=majority

# Firebase Admin SDK Key (for server-side operations)
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_SDK_KEY={"type":"service_account","project_id":"..."}

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Development/Production
NODE_ENV=development
